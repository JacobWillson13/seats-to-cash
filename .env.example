# Copy to .env (git-ignored) and fill in. Read by `make snowflake` and profiles.yml.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/seats_to_cash_rsa.p8
SNOWFLAKE_USER=DBT_TRANSFORMER
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_DATABASE=SEATS_TO_CASH
